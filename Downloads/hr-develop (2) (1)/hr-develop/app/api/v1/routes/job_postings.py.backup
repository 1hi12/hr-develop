# ─────────────────────────────────────────────────────────────
# Department auto-extraction
# ─────────────────────────────────────────────────────────────

_DEPT_KEYWORDS: list[tuple[str, list[str]]] = [
    ("DevOps",            ["devops", " sre ", "cloud architect", " infra ", "platform engineer", "kubernetes", "docker", "terraform", "ansible", "ops engineer"]),
    ("Frontend",          ["frontend", "front-end", "react", " vue", "angular", " ui ", " ux ", "web designer", "interface"]),
    ("Backend",           ["backend", "back-end", " api ", "django", "fastapi", "spring", "node", " php", "golang", " go ", "server"]),
    ("Fullstack",         ["fullstack", "full stack", "full-stack"]),
    ("Mobile",            ["mobile", " ios ", "android", "flutter", "react native", "swift", "kotlin"]),
    ("Data Science",      ["data scien", "machine learning", "ml engineer", "deep learning", " nlp ", " ia ", " ai ", "artificial intel", " llm", "data scientist"]),
    ("Data Engineering",  ["data engineer", "data analyst", "analytics", " bi ", "etl", "business intel", "data pipeline"]),
    ("Cybersécurité",     ["security", "sécurité", "cybersec", "pentest", " soc ", "cyber"]),
    ("IT",                ["it support", "system admin", "network engineer", "infrastructure", "informatique"]),
    ("QA / Testing",      [" qa ", "quality assurance", "test engineer", "qualité", "tester"]),
    ("Product",           ["product manager", "product owner", "chef de produit", "product lead", " po ", " pm ", "scrum", "agile"]),
    ("Design",            ["ux designer", "ui designer", "ux/ui", "graphic designer", "motion designer", "visual designer", "product designer"]),
    ("Human Resources",   ["ressources humaines", "human resources", " rh ", "rrh", "recruteur", "recruiter", "talent acquisition", "people ops", "hr manager", "drh"]),
    ("Finance",           ["finance manager", "comptable", "comptabilité", "accounting", "financial analyst", "trésorerie", "controller", "cfo", "directeur financier"]),
    ("Marketing",         ["marketing manager", "marketing specialist", "digital marketing", "growth hacker", " seo ", "content marketer", "brand manager", "campaign"]),
    ("Sales",             ["sales manager", "head of sales", "sales engineer", "commercial", "account manager", "business development", " bdr", " sdr", "account executive", "sales director", "responsable commercial"]),
    ("Legal",             ["legal", "juriste", "compliance officer", "avocat", "paralegal", "counsel"]),
    ("Operations",        ["operations manager", "supply chain", "logistique", "procurement", "ops manager", "chief of staff"]),
    ("Research",          ["research scientist", "chercheur", "r&d", "research engineer", "scientist"]),
    ("Customer Success",  ["customer success", "support client", "customer support", "help desk", "customer experience"]),
    ("Engineering",       ["software engineer", "développeur", "developer", "engineer", "architect", "ingénieur"]),  # Fallback générique
]


def _keyword_department(title: str, description: Optional[str]) -> Optional[str]:
    """Fast keyword match against job title (and first 300 chars of description)."""
    text = (title + " " + (description or "")[:300]).lower()
    for dept, keywords in _DEPT_KEYWORDS:
        if any(kw in text for kw in keywords):
            return dept
    return None


async def _extract_department(title: str, description: Optional[str]) -> Optional[str]:
    """Return department: keyword match first, Gemini fallback for ambiguous titles."""
    # 1. Fast keyword check — no API call
    dept = _keyword_department(title, description)
    if dept:
        return dept

    # 2. Gemini fallback for unrecognised titles
    api_key = settings.effective_api_key
    if not api_key:
        return None

    prompt = (
        "Return ONLY a short department label in English for this job posting. "
        "Choose from: DevOps, Frontend, Backend, Fullstack, Mobile, Data Science, Data Engineering, "
        "Cybersécurité, IT, QA / Testing, Product, Design, Human Resources, Finance, Marketing, "
        "Sales, Legal, Operations, Research, Customer Success, Engineering.\n"
        "One label only, no explanation.\n\n"
        f"Job Title: {title}\n"
        f"Description: {(description or '')[:600]}\n\n"
        "Department:"
    )

    try:
        import os, certifi
        ca = certifi.where()
        if not os.path.isfile(os.environ.get("SSL_CERT_FILE", "")):
            os.environ["SSL_CERT_FILE"] = ca
            os.environ["REQUESTS_CA_BUNDLE"] = ca

        from google import genai
        from google.genai import types

        client = genai.Client(api_key=api_key)
        response = await asyncio.to_thread(
            client.models.generate_content,
            model=settings.litellm_model,
            contents=prompt,
            config=types.GenerateContentConfig(temperature=0.0, max_output_tokens=10),
        )
        result = response.text.strip().strip('"').strip("'").strip()
        return result or None
    except Exception as exc:
        logger.warning("[JobPosting] Department extraction failed: %s", exc)
        return None


# ─────────────────────────────────────────────────────────────
# Request/Response Models
# ─────────────────────────────────────────────────────────────

class CreateJobPostingRequest(BaseModel):
    title: str = Field(..., min_length=3, max_length=512)
    description: Optional[str] = None
    department: Optional[str] = None
    location: Optional[str] = None
    employment_type: str = Field(default="full-time", pattern="^(full-time|part-time|contract|internship)$")
    required_skills: list[str] = Field(default_factory=list)
    preferred_skills: list[str] = Field(default_factory=list)
    min_years_experience: Optional[float] = Field(default=None, ge=0)
    max_years_experience: Optional[float] = Field(default=None, ge=0)
    seniority_level: Optional[str] = Field(default=None, pattern="^(junior|mid|senior|lead|executive)$")
    created_by: Optional[str] = None
    nb_positions: Optional[int] = Field(default=None, ge=1)


class UpdateJobPostingRequest(BaseModel):
    title: Optional[str] = Field(default=None, min_length=3, max_length=512)
    description: Optional[str] = None
    department: Optional[str] = None
    location: Optional[str] = None
    employment_type: Optional[str] = Field(default=None, pattern="^(full-time|part-time|contract|internship)$")
    required_skills: Optional[list[str]] = None
    preferred_skills: Optional[list[str]] = None
    min_years_experience: Optional[float] = Field(default=None, ge=0)
    max_years_experience: Optional[float] = Field(default=None, ge=0)
    seniority_level: Optional[str] = Field(default=None, pattern="^(junior|mid|senior|lead|executive)$")
    nb_positions: Optional[int] = Field(default=None, ge=1)


class UpdateStatusRequest(BaseModel):
    """Request body for updating job status."""
    status: str = Field(..., pattern="^(active|draft|closed|archived)$")


class JobPostingResponse(BaseModel):
    job_id: str
    title: str
    description: Optional[str] = None
    department: Optional[str] = None
    location: Optional[str] = None
    employment_type: str = "full-time"
    required_skills: list[str] = []
    preferred_skills: list[str] = []
    min_years_experience: Optional[float] = None
    max_years_experience: Optional[float] = None
    seniority_level: Optional[str] = None
    nb_positions: Optional[int] = None
    status: str = "active"
    created_by: Optional[str] = None
    created_at: str
    updated_at: str

    class Config:
        from_attributes = True


